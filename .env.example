# Safe placeholders only. Copy this file to .env.local when the relevant phase
# begins. Never commit real credentials.

# Supabase browser-safe values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase credential; never expose it to frontend code.
# Copy the `sb_secret_...` value from Supabase Project Settings > API Keys.
SUPABASE_SECRET_KEY=

# Local AI runtime
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
ALLOW_PAID_AI=false

# Trading safety switches
ENABLE_PAPER_TRADING=true
ENABLE_LIVE_TRADING=false
ENABLE_SHORT_SELLING=false
